# ── Zorunlu ──────────────────────────────────────────────────────────────────
PORT=3001

# En az 32 karakter. Üretmek için: openssl rand -hex 32
JWT_SECRET=super_secret_random_string_change_this_in_production

ADMIN_USERNAME=yagiz

# bcrypt hash (düz metin parola desteklenmiyor). Üretmek için:
#   docker run --rm node:20 node -e "console.log(require('bcrypt').hashSync('parolan',12))"
# DİKKAT: docker-compose env_file ile okunduğunda `$` karakterleri `$$` olarak
# kaçırılmalıdır. Backend'i doğrudan `node src/index.js` ile çalıştırıyorsanız
# kaçırılmamalıdır.
ADMIN_PASSWORD_HASH=$2b$12$...replace_with_bcrypt_hash

# Panelin erişildiği origin(ler). Virgülle birden fazla verilebilir.
ALLOWED_ORIGIN=http://localhost:5173

# ── İsteğe bağlı ─────────────────────────────────────────────────────────────
# Terminal SSH ile bağlanacaksa (boşsa konteyner içinde bash açılır)
SSH_HOST=
SSH_USER=root

# Aynı anda açık kalabilecek terminal oturumu sayısı
MAX_TERMINAL_SESSIONS=10

# Socket koptuktan sonra PTY'nin yaşayacağı süre (ms)
TERMINAL_RECONNECT_MS=1200000

# Oturum çerezine Secure bayrağı. NODE_ENV=production ile otomatik açılır;
# panel HTTP üzerinden de kullanılıyorsa false bırakın.
# COOKIE_SECURE=false

# Çıkış yapılmış (revoke edilmiş) JWT'lerin jti listesinin tutulduğu dosya.
# Backend yeniden başladığında logout edilmiş bir token'ın tekrar geçerli
# olmaması için diske yazılır. Süresi dolan kayıtlar otomatik temizlenir.
# REVOKED_TOKEN_FILE=/root/serverpanel/backend/logs/revoked-tokens.json
