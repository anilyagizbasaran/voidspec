# nginx:alpine'in 20-envsubst-on-templates.sh betiği bu dosyayı işleyip
# /etc/nginx/conf.d/default.conf üretir. Yalnızca ortamda TANIMLI değişkenler
# değiştirilir; $host, $request_uri gibi nginx değişkenleri olduğu gibi kalır.

# ── Ortak ayarlar ────────────────────────────────────────────────────────────
# Backend 500 MB'a kadar upload kabul ediyor ama nginx'in varsayılan limiti
# 1 MB: büyük dosya yüklemeleri 413 ile sessizce düşüyordu.
client_max_body_size 512m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP → HTTPS ─────────────────────────────────────────────────────────────
# Panel root yetkisiyle çalışıyor; oturum çerezinin düz metin bir kanaldan
# gitmesi kabul edilebilir değil. Konteyner içindeki 80/443, dışarıda farklı
# portlara (varsayılan 8080/8443) haritalandığı için hedef portu ortamdan
# alıyoruz — $host portu içermez.
#
# HTTPS'i zorunlu kılmak istemiyorsanız bu server bloğunu, aşağıdaki 443
# bloğundaki `include` satırıyla değiştirin ve COOKIE_SECURE=false yapın.
#
# Hedefte $host değil sabit PANEL_PUBLIC_HOST var: sertifika bu ada göre
# düzenlendiği için IP ile gelen istek IP'ye yönlendirilseydi ad uyuşmaz ve
# tarayıcı sertifika uyarısı verirdi.
server {
    listen 80;
    return 302 https://${PANEL_PUBLIC_HOST}:${PANEL_HTTPS_PORT}$request_uri;
}

# HTTPS. Sertifika docker-entrypoint.d/40-selfsigned-cert.sh tarafından seçilir:
# Let's Encrypt varsa ona symlink, yoksa üretilen self-signed.
server {
    listen 443 ssl;
    http2 on;

    ssl_certificate     /etc/nginx/certs/panel.crt;
    ssl_certificate_key /etc/nginx/certs/panel.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/snippets/panel-locations.conf;
}
